{
  "name": "repoagents",
  "version": "1.0.2",
  "description": "Repo-only agent config for Claude Code, Codex, Grok and Cursor: one AGENTS.md, vendored skills with provenance, one MCP list.",
  "keywords": [
    "agents",
    "agents-md",
    "claude-code",
    "codex",
    "cursor",
    "grok",
    "mcp",
    "skills"
  ],
  "homepage": "https://github.com/grmkris/repoagents#readme",
  "license": "MIT",
  "author": "Kristjan Grm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grmkris/repoagents.git"
  },
  "bin": {
    "repoagents": "dist/repoagents.js"
  },
  "files": [
    "dist/repoagents.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts .",
    "typecheck": "tsc -p tsconfig.json",
    "effect:check": "effect-tsgo diagnostics --project tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "build": "bun build src/main.ts --target bun --minify --outfile dist/repoagents.js",
    "build:bin": "bun scripts/build-binaries.ts",
    "agents:check": "bun src/main.ts check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run effect:check && bun run knip && bun run test && bun run build && bun run agents:check",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/tsgo": "0.50.0",
    "@effect/vitest": "4.0.1",
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.18.0",
    "effect": "4.0.1",
    "knip": "6.39.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-complexity": "2.1.8",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
